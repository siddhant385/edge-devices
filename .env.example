# Device Identity
DEVICE_ID=edge-001
DEVICE_EMAIL=edge-001@devices.ibvap.internal
DEVICE_PASSWORD=generate_a_secure_password_here

# Supabase Auth and URL
SUPABASE_URL=https://your-project.supabase.co
API_KEY=your_supabase_anon_key

# Deprecated FastAPI endpoints (Left for backward compatibility)
API_URL=https://central.example.com/api/v1/detections

# Model and resource controls
MODEL_PATH=models/yolo26n.onnx

# Resilience controls
RECONNECT_DELAY_SECONDS=3
REQUEST_TIMEOUT_SECONDS=5
QUEUE_PATH=data/outbox.jsonl
QUEUE_MAX_RECORDS=1000
SEND_EMPTY_DETECTIONS=false
ENABLE_SENDING=true

# Enable only for desktop/webcam testing. Press Q or Esc in the preview window to stop.
SHOW_PREVIEW=false

