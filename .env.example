# Device Identity
DEVICE_ID=edge-001
DEVICE_EMAIL=edge-001@devices.ibvap.internal
DEVICE_PASSWORD=generate_a_secure_password_here

# Supabase Auth and URL
SUPABASE_URL=https://your-project.supabase.co
API_KEY=your_supabase_anon_key

# Camera Identity. Use CAMERA_SOURCE=0 for the inbuilt webcam,
# or set it to an RTSP URL for a network camera.
CAMERA_ID=border-camera-01
CAMERA_SOURCE=0

# Optional multi-camera configuration. When set, it replaces CAMERA_ID and CAMERA_SOURCE.
# Keep SHOW_PREVIEW=false when using more than one camera.
# CAMERAS=[{"id":"border-camera-01","source":"rtsp://192.168.31.175:8554/"},{"id":"border-camera-02","source":"rtsp://192.168.31.176:8554/"}]

# Deprecated FastAPI endpoints (Left for backward compatibility, API_URL still required by settings but unused by sender)
API_URL=https://central.example.com/api/v1/detections

# Model and resource controls
MODEL_PATH=models/yolo26n.onnx
PROCESS_EVERY_N_FRAMES=5
INFERENCE_SIZE=640
CONFIDENCE_THRESHOLD=0.45
NMS_THRESHOLD=0.5
# Ordered feature pipeline. A later plugin receives detections from earlier plugins.
# Custom plugins use an import path: your_package.face:FaceDetectionPlugin
ENABLED_PLUGINS=object_detection,evidence_capture
TARGET_CLASS_IDS=0

# evidence_capture attaches a JPEG to the selected preceding feature event. The sender
# base64-encodes it in the alert JSON, allowing the durable JSONL outbox to retry it.
EVIDENCE_SOURCE_FEATURE=object_detection
EVIDENCE_MAX_WIDTH=1280
EVIDENCE_JPEG_QUALITY=75

# Required only when ENABLED_PLUGINS includes intrusion_detection. Coordinates are pixels.
# INTRUSION_ZONE_POLYGON=[[100,100],[1180,100],[1180,620],[100,620]]

# Required only when ENABLED_PLUGINS includes virtual_border. Two [x,y] endpoints define
# the border line. Objects crossing this line (requires object_tracking) trigger an alert.
# VIRTUAL_BORDER_LINE=[[0,360],[1280,360]]

# Resilience controls
RECONNECT_DELAY_SECONDS=3
REQUEST_TIMEOUT_SECONDS=5
QUEUE_PATH=data/outbox.jsonl
QUEUE_MAX_RECORDS=1000
SEND_EMPTY_DETECTIONS=false
ENABLE_SENDING=true

# Server-Sent Events endpoint for real-time configuration updates.
# Deprecated: Now uses Supabase Realtime internally
# CONTROL_URL=https://central.example.com/api/v1/control/sse
# CONTROL_RECONNECT_SECONDS=5

# Periodic device health reporting (CPU, memory, temperature, queue depth).
# Deprecated: Now updates Supabase Database internally
# HEARTBEAT_URL=https://central.example.com/api/v1/heartbeat
# HEARTBEAT_INTERVAL_SECONDS=60

# Enable only for desktop/webcam testing. Press Q or Esc in the preview window to stop.
SHOW_PREVIEW=false
